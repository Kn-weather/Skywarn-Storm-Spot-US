# Route @kn-weather scoped packages to GitHub Packages registry
@kn-weather:registry=https://npm.pkg.github.com

# GitHub Packages requires authentication for both publish and install of private packages.
# For public packages, anonymous install works; for publish, you need a PAT with write:packages scope.
#
# To authenticate locally, add to your ~/.npmrc (NOT this file — this is committed to the repo):
#   //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
#
# Or use: npm login --scope=@kn-weather --registry=https://npm.pkg.github.com
